CREATE TABLE cook_event_consumption (
  event_id TEXT NOT NULL REFERENCES cook_event(id) ON DELETE CASCADE,
  lot_id TEXT NOT NULL,
  quantity_numerator INTEGER,
  quantity_denominator INTEGER,
  unit_code TEXT,
  PRIMARY KEY (event_id, lot_id)
);

CREATE TABLE cook_event_inventory_before (
  event_id TEXT NOT NULL REFERENCES cook_event(id) ON DELETE CASCADE,
  id TEXT NOT NULL,
  ingredient_id TEXT NOT NULL,
  location_id TEXT NOT NULL,
  amount_kind TEXT NOT NULL,
  quantity_numerator INTEGER,
  quantity_denominator INTEGER,
  unit_code TEXT,
  approximate_level TEXT,
  purchased_on TEXT,
  opened_on TEXT,
  frozen_on TEXT,
  manufacturer_use_by TEXT,
  user_use_by TEXT,
  PRIMARY KEY (event_id, id)
);

CREATE TABLE cook_event_undo (
  event_id TEXT NOT NULL PRIMARY KEY REFERENCES cook_event(id) ON DELETE CASCADE,
  undone_on TEXT NOT NULL
);
