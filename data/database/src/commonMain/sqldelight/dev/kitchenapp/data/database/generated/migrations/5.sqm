CREATE TABLE shopping_list (
  id TEXT NOT NULL PRIMARY KEY CHECK (id = 'current'),
  created_at TEXT NOT NULL
);

CREATE TABLE shopping_list_item (
  id TEXT NOT NULL PRIMARY KEY,
  list_id TEXT NOT NULL REFERENCES shopping_list(id) ON DELETE CASCADE,
  ingredient_id TEXT NOT NULL,
  ingredient_name TEXT NOT NULL,
  quantity_numerator INTEGER,
  quantity_denominator INTEGER,
  unit_code TEXT,
  checked INTEGER NOT NULL DEFAULT 0 CHECK (checked IN (0, 1)),
  CHECK ((quantity_numerator IS NULL) = (quantity_denominator IS NULL))
);

CREATE TABLE shopping_list_item_recipe (
  shopping_item_id TEXT NOT NULL REFERENCES shopping_list_item(id) ON DELETE CASCADE,
  recipe_id TEXT NOT NULL,
  PRIMARY KEY (shopping_item_id, recipe_id)
);
