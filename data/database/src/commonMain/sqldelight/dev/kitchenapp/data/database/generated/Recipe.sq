enableForeignKeys:
PRAGMA foreign_keys = 1;

selectIngredientById:
SELECT ingredient.*, ingredient_alias.alias AS alias
FROM ingredient
LEFT JOIN ingredient_alias ON ingredient_alias.ingredient_id = ingredient.id
WHERE ingredient.id = ?;

selectAllIngredients:
SELECT ingredient.*, ingredient_alias.alias AS alias
FROM ingredient
LEFT JOIN ingredient_alias ON ingredient_alias.ingredient_id = ingredient.id
ORDER BY ingredient.name COLLATE NOCASE, ingredient_alias.alias COLLATE NOCASE;

insertIngredient:
INSERT INTO ingredient(id, name) VALUES (?, ?);

selectIngredientExists:
SELECT id FROM ingredient WHERE id = ?;

updateIngredient:
UPDATE ingredient SET name = ? WHERE id = ?;

deleteIngredientAliases:
DELETE FROM ingredient_alias WHERE ingredient_id = ?;

insertIngredientAlias:
INSERT INTO ingredient_alias(ingredient_id, alias) VALUES (?, ?);

deleteIngredient:
DELETE FROM ingredient WHERE id = ?;

selectRecipeById:
SELECT id, name, servings, directions_text AS directionsText, notes,
       source_name AS sourceName, source_url AS sourceUrl,
       prep_time_seconds AS prepTimeSeconds, cook_time_seconds AS cookTimeSeconds,
       chilling_time_seconds AS chillingTimeSeconds, total_time_seconds AS totalTimeSeconds,
       imported_at AS importedAt, image_source_url AS imageSourceUrl
FROM recipe WHERE id = ?;

selectRecipeImageById:
SELECT bytes, media_type AS mediaType FROM recipe_image WHERE recipe_id = ?;

insertRecipeImage:
INSERT OR REPLACE INTO recipe_image(recipe_id, bytes, media_type) VALUES (?, ?, ?);

selectAllRecipes:
SELECT * FROM recipe ORDER BY name COLLATE NOCASE, id;

insertRecipe:
INSERT INTO recipe(
  id, name, servings, directions_text, notes, source_name, source_url,
  prep_time_seconds, cook_time_seconds, chilling_time_seconds, total_time_seconds,
  imported_at, image_source_url
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateRecipe:
UPDATE recipe SET
  name = ?, servings = ?, directions_text = ?, notes = ?, source_name = ?, source_url = ?,
  prep_time_seconds = ?, cook_time_seconds = ?, chilling_time_seconds = ?, total_time_seconds = ?,
  imported_at = ?, image_source_url = ?
WHERE id = ?;

deleteRecipe:
DELETE FROM recipe WHERE id = ?;

deleteRecipeCategories:
DELETE FROM recipe_category WHERE recipe_id = ?;

insertRecipeCategory:
INSERT INTO recipe_category(recipe_id, position, name) VALUES (?, ?, ?);

selectRecipeCategories:
SELECT name FROM recipe_category WHERE recipe_id = ? ORDER BY position;

selectAllRecipeCategoryNames:
SELECT name FROM recipe_category_catalog ORDER BY name COLLATE NOCASE, name;

insertRecipeCategoryName:
INSERT OR IGNORE INTO recipe_category_catalog(name) VALUES (?);

deleteRecipeCategoryName:
DELETE FROM recipe_category_catalog WHERE name = ?;

deleteRecipeIngredients:
DELETE FROM recipe_ingredient WHERE recipe_id = ?;

insertRecipeIngredient:
INSERT INTO recipe_ingredient(
  id, recipe_id, position, ingredient_id,
  quantity_numerator, quantity_denominator,
  quantity_high_numerator, quantity_high_denominator,
  unit_code, preparation, importance, approximate_level, raw_line
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectRecipeIngredients:
SELECT id, recipe_id AS recipeId, position, ingredient_id AS ingredientId,
       quantity_numerator AS quantityNumerator, quantity_denominator AS quantityDenominator,
       quantity_high_numerator AS quantityHighNumerator,
       quantity_high_denominator AS quantityHighDenominator,
       unit_code AS unitCode, preparation, importance,
       approximate_level AS approximateLevel, raw_line AS rawLine
FROM recipe_ingredient WHERE recipe_id = ? ORDER BY position;

selectKitchenLocations:
SELECT * FROM kitchen_location ORDER BY name COLLATE NOCASE, id;

insertKitchenLocation:
INSERT INTO kitchen_location(id, name) VALUES (?, ?);

deleteKitchenLocations:
DELETE FROM kitchen_location;

selectInventoryLots:
SELECT id, ingredient_id AS ingredientId, location_id AS locationId,
       amount_kind AS amountKind, quantity_numerator AS quantityNumerator,
       quantity_denominator AS quantityDenominator, unit_code AS unitCode,
       approximate_level AS approximateLevel, purchased_on AS purchasedOn,
       opened_on AS openedOn, frozen_on AS frozenOn,
       manufacturer_use_by AS manufacturerUseBy, user_use_by AS userUseBy
FROM inventory_lot ORDER BY id;

insertInventoryLot:
INSERT INTO inventory_lot(
  id, ingredient_id, location_id, amount_kind,
  quantity_numerator, quantity_denominator, unit_code, approximate_level,
  purchased_on, opened_on, frozen_on, manufacturer_use_by, user_use_by
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteInventoryLots:
DELETE FROM inventory_lot;

selectAvailableEquipment:
SELECT name FROM available_equipment ORDER BY normalized_name;

insertAvailableEquipment:
INSERT INTO available_equipment(normalized_name, name) VALUES (?, ?);

deleteAvailableEquipment:
DELETE FROM available_equipment;

selectHardExclusions:
SELECT ingredient_id AS ingredientId FROM hard_exclusion ORDER BY ingredient_id;

insertHardExclusion:
INSERT INTO hard_exclusion(ingredient_id) VALUES (?);

deleteHardExclusions:
DELETE FROM hard_exclusion;

selectAllergens:
SELECT ingredient_id AS ingredientId FROM allergen ORDER BY ingredient_id;

insertAllergen:
INSERT INTO allergen(ingredient_id) VALUES (?);

deleteAllergens:
DELETE FROM allergen;

selectIngredientPreferences:
SELECT ingredient_id AS ingredientId, strength, score
FROM ingredient_preference ORDER BY ingredient_id;

insertIngredientPreference:
INSERT INTO ingredient_preference(ingredient_id, strength, score) VALUES (?, ?, ?);

deleteIngredientPreferences:
DELETE FROM ingredient_preference;


insertCookEvent:
INSERT INTO cook_event(id, recipe_id, cooked_on, servings, note) VALUES (?, ?, ?, ?, ?);

insertCookConsumption:
INSERT INTO cook_event_consumption(event_id, lot_id, quantity_numerator, quantity_denominator, unit_code)
VALUES (?, ?, ?, ?, ?);

selectLotBeforeCooking:
SELECT id, ingredient_id AS ingredientId, location_id AS locationId,
       amount_kind AS amountKind, quantity_numerator AS quantityNumerator,
       quantity_denominator AS quantityDenominator, unit_code AS unitCode,
       approximate_level AS approximateLevel, purchased_on AS purchasedOn,
       opened_on AS openedOn, frozen_on AS frozenOn,
       manufacturer_use_by AS manufacturerUseBy, user_use_by AS userUseBy
FROM cook_event_inventory_before WHERE event_id = ? ORDER BY id;

insertLotBeforeCooking:
INSERT INTO cook_event_inventory_before(
  event_id, id, ingredient_id, location_id, amount_kind,
  quantity_numerator, quantity_denominator, unit_code, approximate_level,
  purchased_on, opened_on, frozen_on, manufacturer_use_by, user_use_by
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertCookLeftover:
INSERT INTO leftover(id, cook_event_id, ingredient_id, name, quantity_numerator,
                    quantity_denominator, unit_code, prepared_on, use_by)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectLeftovers:
SELECT id, cook_event_id AS cookEventId, ingredient_id AS ingredientId,
       name, quantity_numerator AS quantityNumerator,
       quantity_denominator AS quantityDenominator, unit_code AS unitCode,
       prepared_on AS preparedOn, use_by AS useBy
FROM leftover ORDER BY prepared_on DESC, id;

selectCookLeftoversForEvent:
SELECT id FROM leftover WHERE cook_event_id = ? ORDER BY id;

deleteCookLeftovers:
DELETE FROM leftover WHERE cook_event_id = ?;

selectCookEventExists:
SELECT id FROM cook_event WHERE id = ?;

selectCookEventUndone:
SELECT event_id FROM cook_event_undo WHERE event_id = ?;

insertCookEventUndo:
INSERT INTO cook_event_undo(event_id, undone_on) VALUES (?, ?);

selectCurrentShoppingList:
SELECT created_at AS createdAt FROM shopping_list WHERE id = 'current';

upsertCurrentShoppingList:
INSERT OR REPLACE INTO shopping_list(id, created_at) VALUES ('current', ?);

deleteCurrentShoppingList:
DELETE FROM shopping_list WHERE id = 'current';

selectCurrentShoppingListItems:
SELECT id, ingredient_id AS ingredientId, ingredient_name AS ingredientName,
       quantity_numerator AS quantityNumerator, quantity_denominator AS quantityDenominator,
       unit_code AS unitCode, checked
FROM shopping_list_item WHERE list_id = 'current'
ORDER BY ingredient_name COLLATE NOCASE, unit_code, id;

deleteCurrentShoppingListItems:
DELETE FROM shopping_list_item WHERE list_id = 'current';

insertCurrentShoppingListItem:
INSERT INTO shopping_list_item(
  id, list_id, ingredient_id, ingredient_name, quantity_numerator,
  quantity_denominator, unit_code, checked
) VALUES (?, 'current', ?, ?, ?, ?, ?, ?);

deleteCurrentShoppingListItemRecipes:
DELETE FROM shopping_list_item_recipe
WHERE shopping_item_id IN (SELECT id FROM shopping_list_item WHERE list_id = 'current');

insertShoppingListItemRecipe:
INSERT INTO shopping_list_item_recipe(shopping_item_id, recipe_id) VALUES (?, ?);

selectCurrentShoppingListItemRecipes:
SELECT shopping_item_id AS shoppingItemId, recipe_id AS recipeId
FROM shopping_list_item_recipe
ORDER BY shopping_item_id, recipe_id;

selectCurrentShoppingListItemExists:
SELECT id FROM shopping_list_item WHERE list_id = 'current' AND id = ?;

setCurrentShoppingListItemChecked:
UPDATE shopping_list_item SET checked = ? WHERE list_id = 'current' AND id = ?;

deleteRecipeMealTypes:
DELETE FROM recipe_meal_type WHERE recipe_id = ?;

insertRecipeMealType:
INSERT INTO recipe_meal_type(recipe_id, position, name) VALUES (?, ?, ?);

selectRecipeMealTypes:
SELECT name FROM recipe_meal_type WHERE recipe_id = ? ORDER BY position;

deleteRecipeEquipmentSubstitutes:
DELETE FROM recipe_equipment_substitute WHERE recipe_id = ?;

deleteRecipeEquipmentRequirements:
DELETE FROM recipe_equipment_requirement WHERE recipe_id = ?;

insertRecipeEquipmentRequirement:
INSERT INTO recipe_equipment_requirement(recipe_id, position, equipment, kind)
VALUES (?, ?, ?, ?);

selectRecipeEquipmentRequirements:
SELECT position, equipment, kind
FROM recipe_equipment_requirement WHERE recipe_id = ? ORDER BY position;

insertRecipeEquipmentSubstitute:
INSERT INTO recipe_equipment_substitute(recipe_id, requirement_position, position, name)
VALUES (?, ?, ?, ?);

selectRecipeEquipmentSubstitutes:
SELECT requirement_position AS requirementPosition, name
FROM recipe_equipment_substitute WHERE recipe_id = ?
ORDER BY requirement_position, position;
